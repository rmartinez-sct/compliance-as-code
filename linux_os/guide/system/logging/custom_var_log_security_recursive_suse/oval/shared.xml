<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure all logs in /var/log have 0640 permissions or stricter.") }}}
    <criteria>
      <criterion comment="Check /var/log permissions recursively" test_ref="test_custom_var_log_security_recursive_suse" />
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="any_exist" comment="All files in /var/log have max 0640 permissions" id="test_custom_var_log_security_recursive_suse" version="1">
    <unix:object object_ref="obj_custom_var_log_security_recursive_suse" />
    <unix:state state_ref="state_custom_var_log_security_recursive_suse" />
  </unix:file_test>

  <unix:file_object id="obj_custom_var_log_security_recursive_suse" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="local" />
    <unix:path>/var/log</unix:path>
    <unix:filename operation="pattern match">.*</unix:filename>
  </unix:file_object>

  <unix:file_state id="state_custom_var_log_security_recursive_suse" version="1" operator="AND">
    <unix:suid datatype="boolean">false</unix:suid>
    <unix:sgid datatype="boolean">false</unix:sgid>
    <unix:sticky datatype="boolean">false</unix:sticky>
    <unix:uexec datatype="boolean">false</unix:uexec>
    <unix:gwrite datatype="boolean">false</unix:gwrite>
    <unix:gexec datatype="boolean">false</unix:gexec>
    <unix:oread datatype="boolean">false</unix:oread>
    <unix:owrite datatype="boolean">false</unix:owrite>
    <unix:oexec datatype="boolean">false</unix:oexec>
  </unix:file_state>
</def-group>
