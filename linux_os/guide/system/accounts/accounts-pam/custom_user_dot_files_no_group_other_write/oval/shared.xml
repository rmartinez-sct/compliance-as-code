<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure hidden files in user homes are not group or world writable") }}}
    <criteria>
      <criterion comment="Hidden files are not group or world writable" test_ref="test_{{{ rule_id }}}" />
    </criteria>
  </definition>

  <!-- El test da PASS solo si NO EXISTE (none_exist) ningún archivo con permisos inseguros -->
  <unix:file_test id="test_{{{ rule_id }}}" check="all" check_existence="none_exist" version="1" comment="Find writable hidden files">
    <unix:object object_ref="object_{{{ rule_id }}}"/>
  </unix:file_test>

  <!-- "find /home": Busca recursivamente todos los archivos ocultos (.*) -->
  <unix:file_object id="object_{{{ rule_id }}}" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="local"/>
    <unix:path>/home</unix:path>
    <unix:filename operation="pattern match">^\..+$</unix:filename>
    <!-- Filtro 1: Quedarnos solo con archivos regulares (ignorar carpetas como .ssh) -->
    <filter action="include">state_{{{ rule_id }}}_is_regular</filter>
    <!-- Filtro 2: Quedarnos solo con los que tengan permisos excesivos -->
    <filter action="include">state_{{{ rule_id }}}_is_writable</filter>
  </unix:file_object>

  <unix:file_state id="state_{{{ rule_id }}}_is_regular" version="1">
    <unix:type operation="equals">regular</unix:type>
  </unix:file_state>

  <!-- Condición de vulnerabilidad: Escritura de grupo o de otros activada -->
  <unix:file_state id="state_{{{ rule_id }}}_is_writable" operator="OR" version="1">
    <unix:gwrite datatype="boolean">true</unix:gwrite>
    <unix:owrite datatype="boolean">true</unix:owrite>
  </unix:file_state>
</def-group>
