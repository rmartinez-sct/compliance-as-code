<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure local interactive users home directories have 0750 permissions or more restrictive.") }}}
    <criteria>
      <criterion test_ref="test_custom_interactive_home_perms_suse" comment="Local interactive users home directories have 0750 permissions or stricter"/>
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="any_exist" id="test_custom_interactive_home_perms_suse" version="1" comment="Check 0750 permissions on local interactive user homes">
    <unix:object object_ref="obj_custom_interactive_home_perms_suse"/>
    <unix:state state_ref="state_custom_interactive_home_perms_suse"/>
  </unix:file_test>

  <!-- Evalúa solo directorios reales (excluye symlinks), sin recursividad -->
  <unix:file_object id="obj_custom_interactive_home_perms_suse" version="1" comment="Home directories of local interactive users">
    <unix:behaviors recurse="directories" recurse_direction="none" max_depth="-1" recurse_file_system="all"/>
    <unix:path var_ref="var_custom_interactive_home_dirs_suse" var_check="at least one"/>
    <unix:filename xsi:nil="true"/>
    <filter action="exclude">state_custom_interactive_home_is_symlink_suse</filter>
  </unix:file_object>

  <unix:file_state id="state_custom_interactive_home_is_symlink_suse" version="1">
    <unix:type operation="equals">symbolic link</unix:type>
  </unix:file_state>

  <!-- Excluye root/halt/sync/shutdown, UID 0, home igual a "/" y shells nologin/false -->
  <ind:textfilecontent54_object id="obj_custom_etc_passwd_interactive_homes_suse" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match">^(?!(?:root|halt|sync|shutdown):)[^:\n]+:[^:\n]*:[1-9][0-9]*:[^:\n]*:[^:\n]*:(/[^:\n]+?)/?:(?!(?:/usr)?/(?:sbin/nologin|bin/false)$)[^:\n]+$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_custom_interactive_home_dirs_suse" datatype="string" version="1" comment="Home directories of local interactive users">
    <object_component object_ref="obj_custom_etc_passwd_interactive_homes_suse" item_field="subexpression"/>
  </local_variable>

  <!-- Mask 0027: sin escritura para grupo ni ningún permiso para otros (0750 o más restrictivo) -->
  <unix:file_state id="state_custom_interactive_home_perms_suse" version="1" operator="AND">
    <unix:gwrite datatype="boolean">false</unix:gwrite>
    <unix:oread datatype="boolean">false</unix:oread>
    <unix:owrite datatype="boolean">false</unix:owrite>
    <unix:oexec datatype="boolean">false</unix:oexec>
  </unix:file_state>
</def-group>
