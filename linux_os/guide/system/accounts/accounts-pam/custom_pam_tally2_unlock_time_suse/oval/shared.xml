<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure pam_tally2 unlock_time is configured to the required variable") }}}
    <criteria>
      <criterion comment="Check unlock_time in /etc/pam.d/login matches variable" test_ref="test_custom_pam_tally2_unlock_time" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" id="test_custom_pam_tally2_unlock_time" version="1" comment="Check unlock_time parameter">
    <ind:object object_ref="obj_custom_pam_tally2_unlock_time" />
    <ind:state state_ref="state_custom_pam_tally2_unlock_time" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_custom_pam_tally2_unlock_time" version="1">
    <ind:filepath>/etc/pam.d/login</ind:filepath>
    <!-- Los paréntesis en ([0-9]+) capturan el valor exacto que haya en el archivo -->
    <ind:pattern operation="pattern match">^[[:space:]]*auth[[:space:]]+required[[:space:]]+pam_tally2\.so.*unlock_time=([0-9]+)\b</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_state id="state_custom_pam_tally2_unlock_time" version="1">
    <!-- Aquí comparamos el valor capturado con nuestra variable externa -->
    <ind:subexpression datatype="int" operation="equals" var_ref="var_accounts_passwords_pam_tally2_unlock_time" />
  </ind:textfilecontent54_state>

  <!-- Importar la variable desde el perfil -->
  <external_variable comment="Unlock time for pam_tally2" datatype="int" id="var_accounts_passwords_pam_tally2_unlock_time" version="1" />
</def-group>
