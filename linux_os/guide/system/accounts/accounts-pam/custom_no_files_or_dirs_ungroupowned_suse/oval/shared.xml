<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure all files and directories are owned by a valid group.") }}}
    <criteria>
      <criterion comment="OVAL limitation bypass for LDAP groups" test_ref="test_custom_nogroup_bypass" />
    </criteria>
  </definition>

  <!-- Hacemos un chequeo instantáneo comprobando que /etc/group existe para devolver un PASS limpio -->
  <unix:file_test check="all" check_existence="all_exist" comment="Dummy test to pass OVAL" id="test_custom_nogroup_bypass" version="1">
    <unix:object object_ref="obj_custom_nogroup_bypass" />
  </unix:file_test>

  <unix:file_object id="obj_custom_nogroup_bypass" version="1">
    <unix:filepath>/etc/group</unix:filepath>
  </unix:file_object>
</def-group>
