<def-group xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure all non-root home directories exist.") }}}
    <criteria>
      <criterion test_ref="test_custom_home_dirs_exist_suse" comment="the number of existing home directories equals the number of homes in /etc/passwd"/>
    </criteria>
  </definition>

  <!-- A home that does not exist produces NO item, so check_existence="all_exist" cannot detect it.
       Instead, the number of distinct homes in scope is compared with the number of them that exist.
       Both numbers are visible in the report as the values of the two count variables. -->
  <ind:variable_test check="all" check_existence="at_least_one_exists" id="test_custom_home_dirs_exist_suse" version="1" comment="existing homes == expected homes">
    <ind:object object_ref="obj_custom_home_dirs_existing_count_suse"/>
    <ind:state state_ref="state_custom_home_dirs_count_equal_suse"/>
  </ind:variable_test>

  <ind:variable_object id="obj_custom_home_dirs_existing_count_suse" version="1" comment="number of homes that exist">
    <ind:var_ref>var_custom_home_dirs_existing_count_suse</ind:var_ref>
  </ind:variable_object>

  <ind:variable_state id="state_custom_home_dirs_count_equal_suse" version="1" comment="must equal the number of homes in scope">
    <ind:value datatype="int" operation="equals" var_ref="var_custom_home_dirs_expected_count_suse"/>
  </ind:variable_state>

  <!-- Number of distinct homes in scope -->
  <local_variable id="var_custom_home_dirs_expected_count_suse" datatype="int" version="1" comment="number of distinct homes in scope">
    <count>
      <unique>
        <object_component object_ref="obj_custom_etc_passwd_homes_exist_suse" item_field="subexpression"/>
      </unique>
    </count>
  </local_variable>

  <!-- Number of distinct homes that exist -->
  <local_variable id="var_custom_home_dirs_existing_count_suse" datatype="int" version="1" comment="number of those homes that exist">
    <count>
      <unique>
        <object_component object_ref="obj_custom_home_dirs_exist_suse" item_field="path"/>
      </unique>
    </count>
  </local_variable>

  <!-- Directories are addressed with path + nil filename (not filepath), without recursion -->
  <unix:file_object id="obj_custom_home_dirs_exist_suse" version="1" comment="home directories of local users with an interactive shell">
    <unix:behaviors recurse="symlinks and directories" recurse_direction="none" max_depth="-1" recurse_file_system="all"/>
    <unix:path var_ref="var_custom_home_dirs_exist_suse" var_check="at least one"/>
    <unix:filename xsi:nil="true"/>
  </unix:file_object>

  <!-- Homes come from /etc/passwd: UID != 0 and interactive shell (not nologin/false).
       No path is excluded. A trailing slash in the home field is not captured. -->
  <ind:textfilecontent54_object id="obj_custom_etc_passwd_homes_exist_suse" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match">^[^:]+:[^:]*:[1-9][0-9]*:[^:]*:[^:]*:([^:]+?)/?:(?![^:]*(?:nologin|false)$)[^:]+$</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_custom_home_dirs_exist_suse" datatype="string" version="1" comment="home directories in scope">
    <object_component object_ref="obj_custom_etc_passwd_homes_exist_suse" item_field="subexpression"/>
  </local_variable>
</def-group>
