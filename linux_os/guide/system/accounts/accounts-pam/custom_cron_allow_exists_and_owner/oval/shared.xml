<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("The /etc/cron.allow file must exist and be owned by root") }}}
    <criteria>
      <criterion comment="Check /etc/cron.allow exists and is owned by root" test_ref="test_custom_cron_allow_exists_owner" />
    </criteria>
  </definition>

  <!-- check_existence="all_exist" obliga a que el archivo esté presente -->
  <unix:file_test check="all" check_existence="all_exist" comment="/etc/cron.allow exists and owned by root" id="test_custom_cron_allow_exists_owner" version="1">
    <unix:object object_ref="object_custom_cron_allow_owner_file" />
    <unix:state state_ref="state_custom_cron_allow_owner_root" />
  </unix:file_test>

  <unix:file_object id="object_custom_cron_allow_owner_file" version="1">
    <unix:filepath>/etc/cron.allow</unix:filepath>
  </unix:file_object>

  <unix:file_state id="state_custom_cron_allow_owner_root" version="1">
    <unix:user_id datatype="int">0</unix:user_id>
  </unix:file_state>
</def-group>
