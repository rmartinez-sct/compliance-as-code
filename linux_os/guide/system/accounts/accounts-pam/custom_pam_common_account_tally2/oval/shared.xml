<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure pam_tally2 account is configured") }}}
    <criteria>
      <criterion comment="Check pam_tally2 in common-account" test_ref="test_custom_pam_common_account_tally2" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" id="test_custom_pam_common_account_tally2" version="1" comment="Check pam_tally2 in common-account">
    <ind:object object_ref="obj_custom_pam_common_account_tally2" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_custom_pam_common_account_tally2" version="1">
    <ind:filepath>/etc/pam.d/common-account</ind:filepath>
    <ind:pattern operation="pattern match">^\s*account\s+required\s+pam_tally2\.so\s*$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
