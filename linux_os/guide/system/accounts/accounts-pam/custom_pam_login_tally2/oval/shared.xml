<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure pam_tally2 and pam_unix are configured correctly in login") }}}
    <criteria operator="AND">
      <criterion comment="Check pam_tally2 required in login" test_ref="test_custom_pam_login_tally2" />
      <criterion comment="Check pam_unix required in login" test_ref="test_custom_pam_login_unix" />
    </criteria>
  </definition>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" id="test_custom_pam_login_tally2" version="1" comment="Check pam_tally2 in login">
    <ind:object object_ref="obj_custom_pam_login_tally2" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_custom_pam_login_tally2" version="1">
    <ind:filepath>/etc/pam.d/login</ind:filepath>
    <ind:pattern operation="pattern match">^\s*auth\s+required\s+pam_tally2\.so.*deny=</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_test check="all" check_existence="all_exist" id="test_custom_pam_login_unix" version="1" comment="Check pam_unix in login">
    <ind:object object_ref="obj_custom_pam_login_unix" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_custom_pam_login_unix" version="1">
    <ind:filepath>/etc/pam.d/login</ind:filepath>
    <ind:pattern operation="pattern match">^\s*auth\s+required\s+pam_unix\.so</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
