<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure all files and directories are owned by a valid user.") }}}
    <criteria>
      <criterion comment="Check all files have a valid user" test_ref="test_custom_valid_user_owner" />
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="at_least_one_exists" comment="Verify all files have a valid user" id="test_custom_valid_user_owner" version="1">
    <unix:object object_ref="obj_custom_valid_user_owner_files" />
    <unix:state state_ref="state_custom_file_has_valid_uid" />
  </unix:file_test>

  <unix:file_object id="obj_custom_valid_user_owner_files" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" max_depth="-1" recurse_file_system="local" />
    <unix:path>/</unix:path>
    <unix:filename operation="pattern match">.*</unix:filename>
    <filter action="exclude">state_custom_valid_user_exclude_dirs</filter>
  </unix:file_object>

  <!-- Excluimos snapshots y contenedores (Docker/Podman) -->
  <unix:file_state id="state_custom_valid_user_exclude_dirs" version="1">
    <unix:filepath operation="pattern match">^/(dev|proc|sys|run|\.snapshots|var/lib/docker|var/lib/containers|var/lib/containerd)(/.*)?$</unix:filepath>
  </unix:file_state>

  <!-- El UID del archivo debe estar en la lista extraída -->
  <unix:file_state id="state_custom_file_has_valid_uid" version="1">
    <unix:user_id datatype="int" var_check="at least one" var_ref="var_custom_valid_uids" operation="equals" />
  </unix:file_state>

  <!-- MAGIA: Objeto nativo OVAL que pide al OS todos los usuarios (incluyendo LDAP/AD) -->
  <unix:password_object id="obj_custom_all_users" version="1">
    <unix:username operation="pattern match">.*</unix:username>
  </unix:password_object>

  <local_variable id="var_custom_valid_uids" datatype="int" version="1" comment="Lista de UIDs validos del sistema">
    <object_component object_ref="obj_custom_all_users" item_field="user_id" />
  </local_variable>
</def-group>
