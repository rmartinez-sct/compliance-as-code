<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure custom CIS rsyslog drop-in contains exact required configurations and rsyslog.conf has them commented out") }}}
    <criteria operator="AND">
      <!-- 1. Exigir que las reglas estén activas en el archivo drop-in -->
      <criterion comment="mail.err drop-in" test_ref="test_rsyslog_mail_err" />
      <criterion comment="local6,local7 drop-in" test_ref="test_rsyslog_local67" />
      <criterion comment="auth,authpriv drop-in" test_ref="test_rsyslog_auth" />
      <criterion comment="local2,local3 drop-in" test_ref="test_rsyslog_local23" />
      <criterion comment="warning,err drop-in" test_ref="test_rsyslog_warn_err" />
      <criterion comment="emerg drop-in" test_ref="test_rsyslog_emerg" />
      <criterion comment="mail.info drop-in" test_ref="test_rsyslog_mail_info" />
      <criterion comment="mail.all drop-in" test_ref="test_rsyslog_mail_all" />
      <criterion comment="crit drop-in" test_ref="test_rsyslog_crit" />
      <criterion comment="cron drop-in" test_ref="test_rsyslog_cron" />
      <criterion comment="mail.warn drop-in" test_ref="test_rsyslog_mail_warn" />
      <criterion comment="messages drop-in" test_ref="test_rsyslog_messages" />
      <criterion comment="local4,local5 drop-in" test_ref="test_rsyslog_local45" />
      <criterion comment="local0,local1 drop-in" test_ref="test_rsyslog_local01" />

      <!-- 2. Exigir que NINGUNA de estas reglas esté activa en /etc/rsyslog.conf (deben estar comentadas) -->
      <criterion comment="No active directives in /etc/rsyslog.conf" test_ref="test_rsyslog_conf_no_active_directives" />
    </criteria>
  </definition>

  <!-- Verificaciones para /etc/rsyslog.d/99-cis-custom-logging.conf -->
  <ind:textfilecontent54_test id="test_rsyslog_mail_err" check="all" check_existence="all_exist" version="1" comment="1"><ind:object object_ref="obj_rsyslog_mail_err" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_mail_err" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^mail\.err.*\/var\/log\/mail\.err</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_local67" check="all" check_existence="all_exist" version="1" comment="2"><ind:object object_ref="obj_rsyslog_local67" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_local67" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^local6,local7\.\*.*\/var\/log\/localmessages</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_auth" check="all" check_existence="all_exist" version="1" comment="3"><ind:object object_ref="obj_rsyslog_auth" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_auth" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^auth,authpriv\.\*.*\/var\/log\/secure</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_local23" check="all" check_existence="all_exist" version="1" comment="4"><ind:object object_ref="obj_rsyslog_local23" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_local23" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^local2,local3\.\*.*\/var\/log\/localmessages</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_warn_err" check="all" check_existence="all_exist" version="1" comment="5"><ind:object object_ref="obj_rsyslog_warn_err" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_warn_err" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^\*\.=warning;\*\.=err.*\/var\/log\/warn</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_emerg" check="all" check_existence="all_exist" version="1" comment="6"><ind:object object_ref="obj_rsyslog_emerg" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_emerg" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^\*\.emerg.*:omusrmsg:\*</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_mail_info" check="all" check_existence="all_exist" version="1" comment="7"><ind:object object_ref="obj_rsyslog_mail_info" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_mail_info" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^mail\.info.*\/var\/log\/mail\.info</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_mail_all" check="all" check_existence="all_exist" version="1" comment="8"><ind:object object_ref="obj_rsyslog_mail_all" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_mail_all" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^mail\.\*.*\/var\/log\/mail</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_crit" check="all" check_existence="all_exist" version="1" comment="9"><ind:object object_ref="obj_rsyslog_crit" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_crit" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^\*\.crit.*\/var\/log\/warn</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_cron" check="all" check_existence="all_exist" version="1" comment="10"><ind:object object_ref="obj_rsyslog_cron" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_cron" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^cron\.\*.*\/var\/log\/cron</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_mail_warn" check="all" check_existence="all_exist" version="1" comment="11"><ind:object object_ref="obj_rsyslog_mail_warn" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_mail_warn" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^mail\.warning.*\/var\/log\/mail\.warn</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_messages" check="all" check_existence="all_exist" version="1" comment="12"><ind:object object_ref="obj_rsyslog_messages" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_messages" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^\*\.\*;mail\.none;news\.none.*\/var\/log\/messages</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_local45" check="all" check_existence="all_exist" version="1" comment="13"><ind:object object_ref="obj_rsyslog_local45" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_local45" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^local4,local5\.\*.*\/var\/log\/localmessages</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_local01" check="all" check_existence="all_exist" version="1" comment="14"><ind:object object_ref="obj_rsyslog_local01" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_local01" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^local0,local1\.\*.*\/var\/log\/localmessages</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <!-- Test para comprobar que NINGUNA directiva esté sin comentar en /etc/rsyslog.conf -->
  <ind:textfilecontent54_test id="test_rsyslog_conf_no_active_directives" check="all" check_existence="none_exist" version="1" comment="Ensure no uncommented directives exist in rsyslog.conf">
    <ind:object object_ref="obj_rsyslog_conf_active_directives" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="obj_rsyslog_conf_active_directives" version="1">
    <ind:filepath>/etc/rsyslog.conf</ind:filepath>
    <ind:pattern operation="pattern match">^[[:space:]]*(mail\.err|local6,local7\.\*|auth,authpriv\.\*|local2,local3\.\*|\*\.=warning;\*\.=err|\*\.emerg|mail\.info|mail\.\*|\*\.crit|cron\.\*|mail\.warning|\*\.\*;mail\.none;news\.none|local4,local5\.\*|local0,local1\.\*)</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
