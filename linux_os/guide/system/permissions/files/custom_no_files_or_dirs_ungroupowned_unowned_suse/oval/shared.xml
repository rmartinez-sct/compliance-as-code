<def-group xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("No file or directory on local file systems has an unknown owner or group.") }}}
    <criteria operator="AND">
      <criterion test_ref="test_{{{ rule_id }}}_nouser" comment="no file or symlink with a UID missing from /etc/passwd"/>
      <criterion test_ref="test_{{{ rule_id }}}_nouser_dirs" comment="no directory with a UID missing from /etc/passwd"/>
      <criterion test_ref="test_{{{ rule_id }}}_nogroup" comment="no file or symlink with a GID missing from /etc/group"/>
      <criterion test_ref="test_{{{ rule_id }}}_nogroup_dirs" comment="no directory with a GID missing from /etc/group"/>
    </criteria>
  </definition>

  <!-- OpenSCAP returns directories only when filename is nil, and files only when filename is given:
       files and directories are therefore separate objects, each with its own test. -->

  <!-- ===== TUNABLE: IDs that exist only in the directory service (not in /etc/passwd or /etc/group) ===== -->
  <constant_variable id="var_{{{ rule_id }}}_domain_min_id" version="1" datatype="int" comment="UID/GID at or above this value belong to domain accounts">
    <value>20000</value>
  </constant_variable>

  <constant_variable id="var_{{{ rule_id }}}_domain_uids" version="1" datatype="int" comment="individual domain UIDs below the threshold">
    <value>3744</value>
    <value>5013</value>
  </constant_variable>

  <constant_variable id="var_{{{ rule_id }}}_domain_gids" version="1" datatype="int" comment="individual domain GIDs below the threshold">
    <value>3744</value>
  </constant_variable>

  <!-- ===== Local UIDs and GIDs ===== -->
  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_passwd_uids" version="1">
    <ind:filepath>/etc/passwd</ind:filepath>
    <ind:pattern operation="pattern match">^[^:#]+:[^:]*:([0-9]+):</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_object id="obj_{{{ rule_id }}}_group_gids" version="1">
    <ind:filepath>/etc/group</ind:filepath>
    <ind:pattern operation="pattern match">^[^:#]+:[^:]*:([0-9]+):</ind:pattern>
    <ind:instance datatype="int" operation="greater than or equal">1</ind:instance>
  </ind:textfilecontent54_object>

  <local_variable id="var_{{{ rule_id }}}_local_uids" version="1" datatype="int" comment="UIDs defined in /etc/passwd">
    <object_component object_ref="obj_{{{ rule_id }}}_passwd_uids" item_field="subexpression"/>
  </local_variable>

  <local_variable id="var_{{{ rule_id }}}_local_gids" version="1" datatype="int" comment="GIDs defined in /etc/group">
    <object_component object_ref="obj_{{{ rule_id }}}_group_gids" item_field="subexpression"/>
  </local_variable>

  <!-- ===== States: each one matches an owner/group that is KNOWN (used to exclude it) ===== -->
  <unix:file_state id="state_{{{ rule_id }}}_local_user" version="1">
    <unix:user_id datatype="int" operation="equals" var_check="at least one" var_ref="var_{{{ rule_id }}}_local_uids"/>
  </unix:file_state>

  <unix:file_state id="state_{{{ rule_id }}}_domain_user_range" version="1">
    <unix:user_id datatype="int" operation="greater than or equal" var_check="all" var_ref="var_{{{ rule_id }}}_domain_min_id"/>
  </unix:file_state>

  <unix:file_state id="state_{{{ rule_id }}}_domain_user_list" version="1">
    <unix:user_id datatype="int" operation="equals" var_check="at least one" var_ref="var_{{{ rule_id }}}_domain_uids"/>
  </unix:file_state>

  <unix:file_state id="state_{{{ rule_id }}}_local_group" version="1">
    <unix:group_id datatype="int" operation="equals" var_check="at least one" var_ref="var_{{{ rule_id }}}_local_gids"/>
  </unix:file_state>

  <unix:file_state id="state_{{{ rule_id }}}_domain_group_range" version="1">
    <unix:group_id datatype="int" operation="greater than or equal" var_check="all" var_ref="var_{{{ rule_id }}}_domain_min_id"/>
  </unix:file_state>

  <unix:file_state id="state_{{{ rule_id }}}_domain_group_list" version="1">
    <unix:group_id datatype="int" operation="equals" var_check="at least one" var_ref="var_{{{ rule_id }}}_domain_gids"/>
  </unix:file_state>

  <!-- ===== Files and symlinks (filename given), minus entries with a known owner / group ===== -->
  <unix:file_object id="obj_{{{ rule_id }}}_nouser" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" recurse_file_system="local" max_depth="-1"/>
    <unix:path operation="equals">/</unix:path>
    <unix:filename operation="pattern match">.*</unix:filename>
    <filter action="exclude">state_{{{ rule_id }}}_local_user</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_user_range</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_user_list</filter>
  </unix:file_object>

  <unix:file_object id="obj_{{{ rule_id }}}_nogroup" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" recurse_file_system="local" max_depth="-1"/>
    <unix:path operation="equals">/</unix:path>
    <unix:filename operation="pattern match">.*</unix:filename>
    <filter action="exclude">state_{{{ rule_id }}}_local_group</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_group_range</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_group_list</filter>
  </unix:file_object>

  <!-- ===== Directories (filename nil), same filters ===== -->
  <unix:file_object id="obj_{{{ rule_id }}}_nouser_dirs" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" recurse_file_system="local" max_depth="-1"/>
    <unix:path operation="equals">/</unix:path>
    <unix:filename xsi:nil="true"/>
    <filter action="exclude">state_{{{ rule_id }}}_local_user</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_user_range</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_user_list</filter>
  </unix:file_object>

  <unix:file_object id="obj_{{{ rule_id }}}_nogroup_dirs" version="1">
    <unix:behaviors recurse="directories" recurse_direction="down" recurse_file_system="local" max_depth="-1"/>
    <unix:path operation="equals">/</unix:path>
    <unix:filename xsi:nil="true"/>
    <filter action="exclude">state_{{{ rule_id }}}_local_group</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_group_range</filter>
    <filter action="exclude">state_{{{ rule_id }}}_domain_group_list</filter>
  </unix:file_object>

  <!-- PASS only if the filtered objects collect nothing -->
  <unix:file_test id="test_{{{ rule_id }}}_nouser" version="1" check="all" check_existence="none_exist" comment="files or symlinks with an unknown UID">
    <unix:object object_ref="obj_{{{ rule_id }}}_nouser"/>
  </unix:file_test>

  <unix:file_test id="test_{{{ rule_id }}}_nouser_dirs" version="1" check="all" check_existence="none_exist" comment="directories with an unknown UID">
    <unix:object object_ref="obj_{{{ rule_id }}}_nouser_dirs"/>
  </unix:file_test>

  <unix:file_test id="test_{{{ rule_id }}}_nogroup" version="1" check="all" check_existence="none_exist" comment="files or symlinks with an unknown GID">
    <unix:object object_ref="obj_{{{ rule_id }}}_nogroup"/>
  </unix:file_test>

  <unix:file_test id="test_{{{ rule_id }}}_nogroup_dirs" version="1" check="all" check_existence="none_exist" comment="directories with an unknown GID">
    <unix:object object_ref="obj_{{{ rule_id }}}_nogroup_dirs"/>
  </unix:file_test>
</def-group>
